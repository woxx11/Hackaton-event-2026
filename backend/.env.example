# PostgreSQL connection string (Render Postgres, Neon, or local)
DATABASE_URL="postgresql://user:password@host:5432/hisobim?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
