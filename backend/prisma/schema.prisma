// HISOBIM — qarz daftar backend.
// Seller (do'kon egasi) mahsulot va mijozlarini boshqaradi, mijozga
// qarzga mahsulot beradi. Client o'z qarzlarini ko'radi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  name         String
  shopName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products      Product[]
  debts         Debt[]
  sellerClients SellerClient[]

  @@map("sellers")
}

// passwordHash is nullable: a seller can add a client by phone number
// before that person ever opens the app. The client "claims" the account
// (sets a password) the first time they register with that same phone.
model Client {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  debts         Debt[]
  sellerClients SellerClient[]

  @@map("clients")
}

// Which clients belong to which seller's ledger — a client can owe debt
// to more than one seller/shop.
model SellerClient {
  id        String   @id @default(cuid())
  sellerId  String
  clientId  String
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([sellerId, clientId])
  @@map("seller_clients")
}

model Product {
  id        String   @id @default(cuid())
  sellerId  String
  name      String
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller    Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  debtItems DebtItem[]

  @@index([sellerId])
  @@map("products")
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

model Debt {
  id          String     @id @default(cuid())
  sellerId    String
  clientId    String
  totalAmount Decimal    @db.Decimal(12, 2)
  paidAmount  Decimal    @db.Decimal(12, 2) @default(0)
  status      DebtStatus @default(OPEN)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  seller   Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items    DebtItem[]
  payments DebtPayment[]

  @@index([sellerId])
  @@index([clientId])
  @@map("debts")
}

model DebtItem {
  id         String  @id @default(cuid())
  debtId     String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([debtId])
  @@map("debt_items")
}

model DebtPayment {
  id       String   @id @default(cuid())
  debtId   String
  amount   Decimal  @db.Decimal(12, 2)
  paidAt   DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_payments")
}
